# What showcase's terminal types: the launcher, the visitor sign-in
# opened from it twice - signed in, with a pass; and with the building
# service down, which sends the visitor to reception - then the
# Service desk example four times - closed with Home, with Cancel, after
# sending, and by walking away - then the pay at the pump twice, followed
# to all done and declined, its 24 s on the Pi past a board run's
# end, then "Why is this secure?" and the Screen Compiler gallery round
# all its screens - by keyboard alone, as Showcase's host test
# of the showcase does (showcase/showcase-app/tests/showcase.rs,
# the_qemu_script_s_keys_on_the_host). The visitor comes first, so a board
# run, which the watchdog cuts at 15 s, sees them whole. Each `serial` step is one burst of
# keys written to the debug UART's receive side - by NoWayOS's
# tools/qemu-test into QEMU's serial port, by tools/pi-run through the Pi 5's
# Debug Probe - after the screen it waits for. Escapes: \r Enter, \t Tab,
# \e[Z Shift-Tab, \e[B Down, \x20 Space. The launcher starts with focus on
# its first tile; each example screen on its first control after the bar's
# Home. Every name typed starts zqvj, and the reference is 9081726354, both
# of which the expect files forbid.

wait SHOWCASE: ui: showing launcher
# The visitor sign-in (Tab to its tile), and Sign in as a visitor.
serial \t\r
wait SHOWCASE: ui: showing welcome
serial \r
wait SHOWCASE: ui: showing about-you
# A name, no organisation, then Next.
serial zqvje\t\t\t\r
wait SHOWCASE: ui: showing visiting
# Who they are visiting, then Next.
serial zqvjf\t\t\t\r
wait SHOWCASE: ui: showing purpose
# The first reason, then Next.
serial \e[B\t\t\t\r
wait SHOWCASE: ui: showing site-rules
# The rules agreed, then Next.
serial \x20\t\t\t\r
wait SHOWCASE: ui: showing check
# Sign in: the stand-in accepts it a second later, and issues a pass.
serial \t\t\t\r
wait SHOWCASE: ui: showing signed-in
# Done, once the pass has counted down a second.
wait SHOWCASE: ui: countdown drawn alone: 46x47 px of the 1920x1080 screen
serial \r
wait SHOWCASE: ui: showing launcher
# Again, through to checking, then Demo: service down: the stand-in fails
# it, and the visitor is sent to reception; Finish.
serial \t\r
wait SHOWCASE: ui: showing welcome
serial \r
wait SHOWCASE: ui: showing about-you
serial zqvjg\t\t\t\r
wait SHOWCASE: ui: showing visiting
serial zqvjh\t\t\t\r
wait SHOWCASE: ui: showing purpose
serial \e[B\t\t\t\r
wait SHOWCASE: ui: showing site-rules
serial \x20\t\t\t\r
wait SHOWCASE: ui: showing check
serial \t\t\r
wait SHOWCASE: ui: showing not-signed-in
serial \t\r
wait SHOWCASE: ui: showing launcher
# Open the Service desk, and Start.
serial \r
wait SHOWCASE: ui: showing welcome
serial \r
wait SHOWCASE: ui: showing step-text
# A name, then Home: Shift-Tab from the name to Home, and Enter.
serial zqvj\e[Z\r
wait SHOWCASE: ui: showing launcher
# Again: a name, the reference, then Cancel.
serial \r
wait SHOWCASE: ui: showing welcome
serial \r
wait SHOWCASE: ui: showing step-text
serial zqvjb\t\t\r
wait SHOWCASE: ui: showing launcher
# Again, through to sending: the stand-in leaves the first attempt
# unanswered, so it fails when it times out; Try again is accepted; Done.
serial \r
wait SHOWCASE: ui: showing welcome
serial \r
wait SHOWCASE: ui: showing step-text
serial zqvjc\t9081726354\t\t\r
wait SHOWCASE: ui: showing step-choice
serial \e[B\t\t\t\t\r
wait SHOWCASE: ui: showing step-checkbox
serial \x20\t\t\t\t\r
wait SHOWCASE: ui: showing step-notice
serial \t\t\r
wait SHOWCASE: ui: showing review
serial \t\t\r
wait SHOWCASE: ui: showing failed
serial \t\t\r
wait SHOWCASE: ui: showing submitted
# Done, once the confirmation has counted down a second and drawn the
# countdown alone - the same moment in QEMU's test image and on the
# Pi, whose confirmations last 4 s and 10 s.
wait SHOWCASE: ui: countdown drawn alone: 46x47 px of the 1920x1080 screen
serial \r
wait SHOWCASE: ui: showing launcher
# Again: a name, then nobody touches it - the idle warning, the privacy
# reset (5 s and 3 s later in QEMU's test image) and the launcher.
serial \r
wait SHOWCASE: ui: showing welcome
serial \r
wait SHOWCASE: ui: showing step-text
serial zqvjd
wait SHOWCASE: ui: showing idle-warning
wait SHOWCASE: ui: showing launcher
# Pay at the pump (Down to its tile): Down chooses each step's
# option - pump 3, unleaded, £40 - then Next; Pay on the card reader. The
# card reader approves, the screen follows the pump to all done and clears
# itself for the next customer (4 s in QEMU's test image).
serial \e[B\r
wait SHOWCASE: ui: showing welcome
serial \r
wait SHOWCASE: ui: showing pump
serial \e[B\e[B\e[B\t\t\r
wait SHOWCASE: ui: showing fuel
serial \e[B\t\t\t\r
wait SHOWCASE: ui: showing amount
serial \e[B\e[B\e[B\t\t\t\r
wait SHOWCASE: ui: showing check
serial \t\t\t\r
wait SHOWCASE: ui: showing fuelling
wait SHOWCASE: ui: showing launcher
# Again, then Demo: card declined: payment not accepted; Finish.
serial \e[B\r
wait SHOWCASE: ui: showing welcome
serial \r
wait SHOWCASE: ui: showing pump
serial \e[B\t\t\r
wait SHOWCASE: ui: showing fuel
serial \e[B\t\t\t\r
wait SHOWCASE: ui: showing amount
serial \e[B\t\t\t\r
wait SHOWCASE: ui: showing check
serial \t\t\r
wait SHOWCASE: ui: showing not-accepted
serial \t\r
wait SHOWCASE: ui: showing launcher
# "Why is this secure?": Down, Right, Right to the sixth tile, then
# Home, which has the focus.
serial \e[B\e[C\e[C\r
wait SHOWCASE: ui: showing why-secure
serial \r
wait SHOWCASE: ui: showing launcher
# The Screen Compiler gallery: Down, Right to the fifth tile. Next has the
# focus, so Enter goes round all eleven screens and back to the first; on
# the keyboard screen, Tab past the empty code to Check - its error line
# asks for four digits - and Shift-Tab twice back to Next. Then Shift-Tab
# twice to Home.
serial \e[B\e[C\r
wait SHOWCASE: ui: showing gallery-layout
serial \r
wait SHOWCASE: ui: showing gallery-type
serial \r
wait SHOWCASE: ui: showing gallery-text
serial \r
wait SHOWCASE: ui: showing gallery-buttons
serial \r
wait SHOWCASE: ui: showing gallery-surfaces
serial \r
wait SHOWCASE: ui: showing gallery-fields
serial \r
wait SHOWCASE: ui: showing gallery-choices
serial \r
wait SHOWCASE: ui: showing gallery-keyboard
serial \t\t\r
wait SHOWCASE: ui: action Check
serial \e[Z\e[Z
serial \r
wait SHOWCASE: ui: showing gallery-scroll
serial \r
wait SHOWCASE: ui: showing gallery-icons
serial \r
wait SHOWCASE: ui: showing gallery-css
serial \r
wait SHOWCASE: ui: showing gallery-layout
serial \e[Z\e[Z\r
wait SHOWCASE: ui: showing launcher
# The attract loop: left alone, the launcher gives way to slides
# (after 5 s, each for 2 s, in QEMU's test image); Enter only wakes it.
wait SHOWCASE: ui: showing attract-1
wait SHOWCASE: ui: showing attract-2
serial \r
wait SHOWCASE: ui: showing launcher
