# Everything systems/kiosk.system grants, one fact per line. NoWayOS's
# tools/check-system fails the build if the system description grants
# anything not listed here, or lists anything it does not grant, and checks
# the grants again in the kernel objects the Microkit tool generates. A change
# here is a security change: call it out in the pull request.

# A demo system: uart_input runs a development-only program (NoWayOS's
# grant-rules.toml, [development_only]: *-uart-input.elf), refused in a
# product system; and app runs one too, its service a stand-in built into
# it ([development_only]: *-stand-in.elf). Each PD's role (NoWayOS's tools/grant-rules.toml): the UI, the
# broker and the application may hold no device or interrupt, and the
# application no physical address.
system demo
role timer driver
role display display
role input_broker broker
role uart_input input
role app app
role ui ui

# The timer above every PD, so the others may call it; the display above the
# broker and the UI, so a presented frame is shown at once; the broker above
# uart_input, so a key that finds the ring full is drained at once when
# uart_input notifies it - a key's events are sent whole or not at all;
# uart_input above the application and the UI, so the UART's receive FIFO is
# read however busy they are; the application above the UI, so its replies,
# and a privacy reset, never wait for drawing. Full budgets: each PD runs
# only when notified or called, and each run is bounded - the display copies
# one frame, the broker drains at most its rings, uart_input takes at most
# 256 bytes a poll, the application at most its ring of actions and eight
# timed events - until the UI's frame budget is measured, as in
# NoWayOS's ui-interactive.
pd timer priority=6 budget=1000 period=1000
pd display priority=5 budget=1000 period=1000
pd input_broker priority=4 budget=1000 period=1000
pd uart_input priority=3 budget=1000 period=1000
pd app priority=2 budget=1000 period=1000
pd ui priority=1 budget=1000 period=1000

# The UI: exactly the grants NoWayOS's ui-demo.grants gives its UI PD.
map ui present_messages rw
map ui present_control r
map ui display_messages r
map ui display_control rw
map ui framebuffer rw
map ui input_messages r
map ui input_control rw
channel display ui
channel input_broker ui

# The UI's side of the app-UI contract: its actions (messages written by the
# UI only) and the application's reports (read-only but for its own index);
# a channel each way.
map ui actions_messages rw
map ui actions_control r
map ui reports_messages r
map ui reports_control rw
channel app ui

# The application: the other side of those rings, and the timer, for its
# deadlines. Nothing else - no device, interrupt, physical address or
# storage; the service it sends to is a stand-in inside it.
map app actions_messages r
map app actions_control rw
map app reports_messages rw
map app reports_control r
channel app timer notify=timer
call app timer

# The display: its side of the display contract, and the framebuffer,
# read-only, as in NoWayOS's ui-demo.grants.
map display present_messages r
map display present_control rw
map display display_messages rw
map display display_control r
map display framebuffer r

# The broker: the UI's input ring (messages written by the broker only), and
# uart_input's ring, read-only but for its own index; the screen's size,
# read-only configuration.
map input_broker input_messages rw
map input_broker input_control r
map input_broker keys_messages r
map input_broker keys_control rw
map input_broker screen r
channel input_broker uart_input notify=uart_input

# uart_input: the debug UART's registers, uncached and read-only, this PD
# only, and the board's facts about it, read-only - it reads the receive side
# and writes nothing; its ring to the broker; no interrupt: it polls on the
# timer.
device uart_input debug_uart r
map uart_input debug_uart_facts r
map uart_input keys_messages rw
map uart_input keys_control r
channel uart_input timer notify=timer
call uart_input timer

# The timer: QEMU's CPU timer, its interrupt (rpi5b_2gb/kiosk.grants:
# BCM2712's system timer).
irq timer phys_timer
