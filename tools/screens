"""The kiosk reference screens through Screen Compiler.

Runs `screen-compiler check` on every screen in SCREENS/tsx/*.tsx and
`screen-compiler convert` on each one it accepts, then compares what comes out
with what is checked in:

* SCREENS/src/generated/NAME.rs - each convertible screen's Rust, exactly as
  Screen Compiler wrote it, and SCREENS/src/generated/mod.rs, which includes them;
* SCREENS/gaps.txt - which screens convert, and every construct Screen Compiler
  refuses, grouped into gaps and ranked by how many screens each blocks.

If SCREENS/pictures.names exists, it is the list of pictures the screens may
show (`screen-compiler --pictures`): the names of the crate's `pictures`
module, one a line.

With --bless it writes them instead (then review the diff). The screens are
our own synthetic files: never point this at untrusted .tsx.

Usage: screens --screen-compiler BIN --screens DIR [--bless]
Exit status: 0 everything matches (or was written), 1 something differs,
2 usage error or Screen Compiler failed.
"""

import argparse
import difflib
import os
import re
import subprocess
import sys

DIAGNOSTIC = re.compile(
    r"^(?P<file>[^:\s]+\.tsx)(?::(?P<line>\d+):(?P<col>\d+))?: error\[(?P<code>[a-z-]+)\]: (?P<message>.*)$"
)

# Each refused construct, as a gap in generic terms: (code, pattern of the
# message, the gap). The gap may use the pattern's groups. Anything matching
# none is its own gap, named by its code and message, so nothing is lost.
GAPS = [
    ("unsupported", r"^a conditional \(`\?:`\) expression as a child", "conditional rendering"),
    ("unsupported", r"^a logical \(`&&`, `\|\|`, `\?\?`\) expression as a child", "conditional rendering"),
    ("unsupported", r"as a condition is not supported", "conditions other than one prop"),
    ("unsupported", r"in conditional rendering is not supported", "conditions other than one prop"),
    ("unsupported", r"^text mixed with ", "text mixed with a prop"),
    ("unsupported", r"^`[^`]+` inside <Text> is not supported", "text from a prop or state"),
    ("unsupported", r"inserts a value from props or state", "text from a prop or state"),
    ("unsupported", r"^a call to `\.map\(\)` as a child", "lists (`.map()`)"),
    ("unknown-name", r"^`(\w+)` is not a component of the kit", "component <{0}>"),
    ("unknown-element", r"^<(\w+)> is not a component of subset v\d", "component <{0}>"),
    ("unknown-prop", r"^<(\w+)> has no prop `(\w+)`", "prop `{1}` on <{0}>"),
]

HEADER = """\
# `screen-compiler check` on the kiosk reference screens. Generated by
# tools/screens: `make screens` checks it, `make screens-bless` rewrites it.
# The screens are synthetic (tsx/); a gap blocks every screen listed.
"""

MOD_HEADER = """\
//! The kiosk reference screens Screen Compiler converts, exactly as it wrote
//! them, each with a function that builds it on a real `nowayos-ui` tree.
//! Generated by tools/screens (`make screens-bless`): do not edit by hand.

use nowayos_ui::{NodeId, Tree, UiError};

/// Nodes a screen may use: more than any converted screen needs.
pub const CAPACITY: usize = 64;

/// Bytes of long text a screen may hold (builder contract v16): more than
/// any converted screen needs.
pub const TEXT: usize = 4096;

/// Builds a screen on a real tree and returns its root node.
pub type Build = fn(&mut Tree<CAPACITY, TEXT>) -> Result<NodeId, UiError>;
"""


def fail(message):
    print(f"screens: error: {message}", file=sys.stderr)
    sys.exit(2)


def run(screen_compiler, command, name, cwd, pictures=None):
    """Runs Screen Compiler on one screen, given the names of the pictures
    it may show; returns (status, stdout, stderr)."""
    given = ["--pictures", pictures] if pictures else []
    try:
        done = subprocess.run(
            [screen_compiler, command, *given, name], cwd=cwd, capture_output=True, text=True, timeout=120
        )
    except (OSError, subprocess.TimeoutExpired) as err:
        fail(f"screen-compiler {command} {name}: {err}")
    return done.returncode, done.stdout, done.stderr


def gap_of(code, message):
    for gap_code, pattern, gap in GAPS:
        if code != gap_code:
            continue
        match = re.search(pattern, message)
        if match:
            return gap.format(*match.groups())
    return f"{code}: {message}"


def module_name(stem):
    return re.sub(r"[^a-z0-9]", "_", stem.lower())


def analyse(screen_compiler, tsx_dir, pictures=None):
    """Every screen: its Rust if it converts, else its diagnostics."""
    names = sorted(n for n in os.listdir(tsx_dir) if n.endswith(".tsx"))
    if not names:
        fail(f"no screens in {tsx_dir}")
    converted, refused = {}, {}
    for name in names:
        status, out, err = run(screen_compiler, "check", name, tsx_dir, pictures)
        if status == 0:
            status, rust, err = run(screen_compiler, "convert", name, tsx_dir, pictures)
            if status != 0:
                fail(f"screen-compiler check accepts {name} but convert fails:\n{err}")
            converted[name] = rust
        elif status == 1:
            found = []
            for line in (out + err).splitlines():
                match = DIAGNOSTIC.match(line)
                if match:
                    found.append(match)
            if not found:
                fail(f"screen-compiler refused {name} without a diagnostic:\n{out}{err}")
            refused[name] = found
        else:
            fail(f"screen-compiler check {name} exited {status}:\n{out}{err}")
    return names, converted, refused


def report(names, converted, refused):
    """gaps.txt: what converts, the gaps ranked, then every diagnostic."""
    def stem(name):
        return name[: -len(".tsx")]

    gaps = {}
    for name, found in refused.items():
        for match in found:
            gaps.setdefault(gap_of(match["code"], match["message"]), set()).add(stem(name))
    ranked = sorted(gaps.items(), key=lambda item: (-len(item[1]), item[0]))
    lines = [HEADER]
    lines.append(f"screens: {len(names)} - {len(converted)} convert, {len(refused)} refused\n")
    lines.append("convert:")
    lines.extend(f"  {stem(name)}" for name in sorted(converted))
    lines.append("")
    lines.append("gaps, ranked by how many screens each blocks:")
    for gap, screens in ranked:
        lines.append(f"  {len(screens)}  {gap}: {', '.join(sorted(screens))}")
    if not ranked:
        lines.append("  none")
    lines.append("")
    lines.append("what screen-compiler check reports:")
    for name in sorted(refused):
        for match in refused[name]:
            where = f":{match['line']}:{match['col']}" if match["line"] else ""
            lines.append(f"  {name}{where}: error[{match['code']}]: {match['message']}")
    if not refused:
        lines.append("  nothing: every screen converts")
    return "\n".join(lines) + "\n"


def screens_in(rust):
    """The screens in a file of generated Rust: each top-level `pub mod NAME {`
    holding a `pub fn build<B: ui::UiBuilder>(` (the generator's fixed shape)."""
    found, current = [], None
    for line in rust.splitlines():
        if line.startswith("pub mod ") and line.endswith(" {"):
            current = line[len("pub mod ") : -len(" {")]
        elif line.startswith("    pub fn build<B: ui::UiBuilder>(") and current:
            found.append(current)
            current = None
    return found


def mod_rs(converted):
    """src/generated/mod.rs: a module per converted file, a build function
    per screen, and SCREENS listing them; formatted as rustfmt leaves it."""
    builders, modules = [], []
    for name in sorted(converted):
        stem = name[: -len(".tsx")]
        module = module_name(stem)
        screens = screens_in(converted[name])
        if not screens:
            fail(f"no screen found in the Rust Screen Compiler made of {name}")
        modules.append(f"/// `{name}`, converted by Screen Compiler.")
        modules.append(f"pub mod {module} {{")
        modules.append(f'    include!("{stem}.rs");')
        modules.append("}")
        modules.append("")
        for screen in screens:
            function = f"build_{module}" if len(screens) == 1 else f"build_{module}_{screen}"
            label = stem if len(screens) == 1 else f"{stem}/{screen}"
            builders.append((label, function))
            modules.append(f"/// Builds `{name}`'s screen `{screen}` on a real tree.")
            modules.append("///")
            modules.append("/// # Errors")
            modules.append("///")
            modules.append("/// The tree's error, if the screen does not fit it.")
            modules.append(f"pub fn {function}(tree: &mut Tree<CAPACITY, TEXT>) -> Result<NodeId, UiError> {{")
            modules.append(f"    {module}::{screen}::build(tree).map(|nodes| nodes.root)")
            modules.append("}")
            modules.append("")
    lines = [MOD_HEADER]
    lines.append("/// Every converted screen: its file's name and the function that builds it.")
    if builders:
        lines.append("pub const SCREENS: &[(&str, Build)] = &[")
        lines.extend(f'    ("{label}", {function}),' for label, function in builders)
        lines.append("];")
    else:
        lines.append("pub const SCREENS: &[(&str, Build)] = &[];")
    lines.append("")
    return "\n".join(lines + modules).rstrip("\n") + "\n"


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--screen-compiler", required=True, help="the screen-compiler binary")
    parser.add_argument("--screens", required=True, help="the screens crate's directory")
    parser.add_argument("--bless", action="store_true", help="write the files instead of checking them")
    args = parser.parse_args()
    root = os.path.abspath(args.screens)
    tsx_dir = os.path.join(root, "tsx")
    generated = os.path.join(root, "src", "generated")

    pictures = os.path.join(root, "pictures.names")
    pictures = pictures if os.path.isfile(pictures) else None
    names, converted, refused = analyse(os.path.abspath(args.screen_compiler), tsx_dir, pictures)
    expected = {os.path.join(root, "gaps.txt"): report(names, converted, refused)}
    expected[os.path.join(generated, "mod.rs")] = mod_rs(converted)
    for name, rust in converted.items():
        expected[os.path.join(generated, name[: -len(".tsx")] + ".rs")] = rust
    stale = []
    if os.path.isdir(generated):
        stale = [
            os.path.join(generated, n)
            for n in sorted(os.listdir(generated))
            if n.endswith(".rs") and os.path.join(generated, n) not in expected
        ]

    if args.bless:
        os.makedirs(generated, exist_ok=True)
        for path, text in expected.items():
            with open(path, "w", encoding="utf-8", newline="\n") as handle:
                handle.write(text)
        for path in stale:
            os.remove(path)
        print(f"screens: wrote {len(expected)} file(s), removed {len(stale)}: review the diff")
        return 0

    problems = []
    for path, text in expected.items():
        try:
            with open(path, encoding="utf-8") as handle:
                actual = handle.read()
        except FileNotFoundError:
            actual = None
        if actual != text:
            rel = os.path.relpath(path, root)
            problems.append(rel)
            if actual is not None and path.endswith(".txt"):
                sys.stdout.writelines(
                    difflib.unified_diff(
                        actual.splitlines(True), text.splitlines(True), f"{rel} (checked in)", f"{rel} (screen-compiler now)"
                    )
                )
    problems.extend(f"{os.path.relpath(p, root)} (no screen converts to it)" for p in stale)
    if problems:
        print(
            "screens: FAIL - what Screen Compiler makes of the screens differs from what is checked in: "
            + "; ".join(problems)
            + ". Run make screens-bless and review the diff.",
            file=sys.stderr,
        )
        return 1
    print(
        f"screens: PASS - {len(names)} screens: {len(converted)} convert, as checked in; "
        f"{len(refused)} refused, as gaps.txt records"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
